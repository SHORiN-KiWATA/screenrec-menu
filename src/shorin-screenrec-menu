is_running() {
  [[ -r "$PIDFILE" ]] || return 1
  local pid; read -r pid <"$PIDFILE" 2>/dev/null || return 1
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}
notify() { has notify-send && notify-send "$APP_NAME" "$1" || true; }
echo_terminal() { printf "%b\n" "$1"; }

signal_waybar() {
  [[ "${WAYBAR_POKE,,}" == "off" ]] && return 0
  local pids
  pids="$(pgrep -x -u "$UID" waybar 2>/dev/null | tr '\n' ' ')"
  if [[ -n "$pids" ]]; then
    kill -RTMIN+"$WAYBAR_SIG" $pids 2>/dev/null || true
  fi
}
emit_waybar_signal() { signal_waybar; }

start_tick() {
  if [[ -f "$TICKPIDFILE" ]]; then
    local tpid; read -r tpid <"$TICKPIDFILE" 2>/dev/null || true
    [[ -n "$tpid" ]] && kill -TERM "$tpid" 2>/dev/null || true
    rm -f "$TICKPIDFILE"
  fi
  (
    while :; do
      [[ -r "$PIDFILE" ]] || break
      local p; read -r p <"$PIDFILE" 2>/dev/null || p=""
      [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null || break
      signal_waybar
      sleep 1
    done
  ) & echo $! >"$TICKPIDFILE"
}
stop_tick() {
  if [[ -f "$TICKPIDFILE" ]]; then
    local tpid; read -r tpid <"$TICKPIDFILE" 2>/dev/null || true
    [[ -n "$tpid" ]] && kill -TERM "$tpid" 2>/dev/null || true
    rm -f "$TICKPIDFILE"
  fi
}

get_save_dir() {
  local videos
  if has xdg-user-dir; then videos="$(xdg-user-dir VIDEOS 2>/dev/null || true)"; fi
  videos="${videos:-"$HOME/Videos"}"
  echo "${SAVE_DIR_ENV:-"$videos/$APP_NAME"}"
}

open_save_dir() {
  local dir; dir="$(get_save_dir)"
  mkdir -p "$dir"

  if has xdg-open; then
    xdg-open "$dir" >/dev/null 2>&1 &
  elif has gio; then
    gio open "$dir" >/dev/null 2>&1 &
  else
    local msg; msg="$(msg err_need_file_opener)"
    echo_terminal "$msg"; notify "$msg"
  fi
}

list_render_nodes() {
  local d
  for d in /dev/dri/renderD*; do
    [[ -r "$d" ]] && printf '%s\n' "$d"
  done 2>/dev/null || true
}
render_display() {
  local cur="${1:-}"
  if [[ -z "$cur" ]]; then msg render_auto; else printf "%s" "$cur"; fi
}
pick_render_device() {
  local dev="${DRM_DEVICE:-}"
  if [[ -n "$dev" && ! -r "$dev" ]]; then dev=""; fi
  echo -n "$dev"
}

ext_for_codec(){
  local test_codec="$1"
  case "${test_codec,,}" in
    *h264*|*hevc*|avc) echo mp4 ;;
    *vp8*|*vp9*) echo webm ;;
    *av1*) echo mkv ;;
    *) echo mp4 ;;
  esac
}
choose_ext(){
  local e="${SAVE_EXT,,}"
  if [[ -z "$e" || "$e" == "auto" ]]; then
    if [[ "$ENGINE" == "wl-screenrec" ]]; then ext_for_codec "$CODEC_WL"
    else ext_for_codec "$CODEC_WF"; fi
  else
    case "$e" in mp4|mkv|webm) echo "$e" ;; *) echo mp4 ;; esac
  fi
}

# ================== Menus ==================
__norm() { printf '%s' "$1" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

_pick_menu_backend() {
  local pref="${MENU_BACKEND,,}"
  case "$pref" in fuzzel|wofi|rofi|bemenu|fzf|term) : ;; auto|"") pref="auto" ;; *) pref="auto" ;; esac
  
  if [[ "$pref" != "auto" ]]; then
    if has "$pref"; then echo "$pref"; else [[ -t 0 ]] && echo "term" || echo "none"; fi
    return
  fi

  local is_real_terminal=false
  if [[ -t 0 ]]; then
    local current_tty
    current_tty="$(tty 2>/dev/null || true)"
    if [[ "$current_tty" == /dev/pts/* ]]; then
      is_real_terminal=true
    fi
  fi

  if [[ "$is_real_terminal" == true ]]; then
    if has fzf; then echo "fzf"; else echo "term"; fi
  else
    for b in fuzzel wofi rofi bemenu; do has "$b" && { echo "$b"; return; }; done
    echo "none"
  fi
}

menu_pick() {
  local title="${1:-Select}"; shift
  local items=("$@")
  ((${#items[@]})) || return 130

  local backend; backend="$(_pick_menu_backend)"
  local sel rc=130
  case "$backend" in
    fuzzel) set +e; sel="$(printf '%s\n' "${items[@]}" | fuzzel --dmenu -p "$title")"; rc=$?; set -e ;;
    wofi)   set +e; sel="$(printf '%s\n' "${items[@]}" | wofi --dmenu --prompt "$title")"; rc=$?; set -e ;;
    rofi)   set +e; sel="$(printf '%s\n' "${items[@]}" | rofi -dmenu -p "$title")"; rc=$?; set -e ;;
    bemenu) set +e; sel="$(printf '%s\n' "${items[@]}" | bemenu -p "$title")"; rc=$?; set -e ;;
    fzf)    
      set +e
      sel="$(printf '%s\n' "${items[@]}" | fzf --prompt "$title > " --layout=reverse --height=50% --border)"
      rc=$?
      set -e 
      ;;
    term)
      echo "$title"
      local i=1; for it in "${items[@]}"; do printf '  %d) %s\n' "$i" "$it"; ((i++)); done
      printf "%s" "$(msg prompt_enter_number)"
      local idx; set +e; read -r idx; rc=$?; set -e
      if [[ $rc -eq 0 && -n "$idx" && "$idx" =~ ^[0-9]+$ ]]; then
        if (( idx>=1 && idx<=${#items[@]} )); then sel="${items[$((idx-1))]}"; rc=0; fi
      fi
      ;;
    none) return 130 ;;
  esac
  [[ $rc -ne 0 || -z "${sel:-}" ]] && return 130
  printf '%s' "$(__norm "$sel")"
}

# ---------- Outputs / Settings / Mode ----------
list_outputs() {
  local raw=""
  if has niri && has jq; then raw="$(niri msg -j outputs 2>/dev/null | jq -r 'keys[]')"
  elif has niri; then raw="$(niri msg outputs 2>/dev/null | awk -F '[()]' '/^Output/ {print $2}')"
  elif has hyprctl && has jq; then raw="$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name')"
  elif has swaymsg && has jq; then raw="$(swaymsg -t get_outputs 2>/dev/null | jq -r '.[].name')"
  elif has wlr-randr; then raw="$(wlr-randr 2>/dev/null | awk '/^[^ ]/{print $1}')"
  fi
  if [[ -n "$raw" ]]; then awk 'NF>0 {print $1}' <<< "$raw" | sort -u || true; fi
}
decide_output() {
  if [[ -n "$OUTPUT" ]]; then printf '%s' "$OUTPUT"; return 0; fi
  local -a outs; mapfile -t outs < <(list_outputs || true)
  if ((${#outs[@]} == 0)); then printf ""; return 0; fi
  local out_title; out_title="${MENU_TITLE_OUTPUT:-$(msg title_output)}"
  if [[ "${OUTPUT_SELECT}" == "menu" ]] || { [[ "${OUTPUT_SELECT}" == "auto" ]] && ((${#outs[@]} > 1)); }; then
    local pick; pick="$(menu_pick "$out_title" "${outs[@]}")" || return 130
    printf '%s' "$pick"
    return 0
  fi
  printf '%s' "${outs[0]}"
  return 0
}

choose_audio_device_menu() {
  if ! has pactl; then notify "$(msg err_need_pactl)"; return 0; fi
  local -a display_names=() internal_names=()
  while IFS='|' read -r raw_name raw_desc; do
    internal_names+=("$raw_name")
    display_names+=("$raw_desc")
  done < <(
    LC_ALL=C pactl list sources 2>/dev/null | awk '
      /^[ \t]*Name:/ { name=$2 }
      /^[ \t]*Description:/ {
        sub(/^[ \t]*Description:[ \t]*/, ""); desc=$0;
        sub(/^Monitor of /, "", desc);
        if (name ~ /\.monitor$/) type="[系统]"
        else type="[麦克]"
        printf "%s|%s %s\n", name, type, desc
      }' | sort -t '|' -k 2 -r
  )
  local auto_item="$(msg audio_dev_default)"
  local pick; if ! pick="$(menu_pick "$(msg title_audio_dev)" "$auto_item" "${display_names[@]}")"; then return 0; fi
  if [[ "$pick" == "$auto_item" ]]; then
    AUDIO_DEVICE=""; rm -f "$CFG_AUDIO_DEVICE"
  else
    for i in "${!display_names[@]}"; do
      if [[ "${display_names[$i]}" == "$pick" ]]; then
        AUDIO_DEVICE="${internal_names[$i]}"
        printf '%s' "$AUDIO_DEVICE" >"$CFG_AUDIO_DEVICE"
        break
      fi
    done
  fi
}
choose_render_menu() {
  local -a nodes; mapfile -t nodes < <(list_render_nodes | sort -V || true)
  local auto_item="$(msg render_auto)"
  local pick; if ! pick="$(menu_pick "$(msg title_select_render)" "$auto_item" "${nodes[@]}")"; then return 0; fi
  if [[ "$pick" == "$auto_item" ]]; then DRM_DEVICE=""; rm -f "$CFG_DRM"
  else DRM_DEVICE="$pick"; printf '%s' "$DRM_DEVICE" >"$CFG_DRM"; fi
}
choose_filefmt_menu() {
  local auto_item="$(msg ext_auto)"
  local pick; if ! pick="$(menu_pick "$(msg title_select_filefmt)" "$auto_item" "mp4" "mkv" "webm")"; then return 0; fi
  if [[ "$pick" == "$auto_item" ]]; then SAVE_EXT="auto"; rm -f "$CFG_EXT"
  else SAVE_EXT="$pick"; printf '%s' "$SAVE_EXT" >"$CFG_EXT"; fi
}

choose_anim_menu() {
  while :; do
    local fmt_d="$(anim_fmt_display)"
    local mb_d; if [[ "$ANIM_TARGET_MB" =~ ^[1-9][0-9]*$ ]]; then mb_d="${ANIM_TARGET_MB} MB"; else mb_d="$(msg anim_nolimit)"; fi
    local i_fmt="$(msg menu_anim_fmt "$fmt_d")"
    local i_fps="$(msg menu_anim_fps "$GIF_FPS")"
    local i_w="$(msg menu_anim_width "$GIF_MAX_WIDTH")"
    local i_c="$(msg menu_anim_colors "$GIF_COLORS")"
    local i_mb="$(msg menu_anim_budget "$mb_d")"
    local pick; pick="$(menu_pick "$(msg title_anim_settings)" "$i_fmt" "$i_fps" "$i_w" "$i_c" "$i_mb" "$(msg menu_back)")" || return 0

    if [[ "$pick" == "$i_fmt" ]]; then
      local p; p="$(menu_pick "$(msg title_anim_fmt)" "GIF" "WebP")" || continue
      ANIM_FORMAT="${p,,}"; printf '%s' "$ANIM_FORMAT" >"$CFG_ANIM_FMT"
    elif [[ "$pick" == "$i_fps" ]]; then
      # 只列能整除 100 的帧率，否则 GIF 播放速度会失真
      local p; p="$(menu_pick "$(msg title_anim_fps)" "10" "12.5" "20" "25" "50")" || continue
      GIF_FPS="$p"; printf '%s' "$GIF_FPS" >"$CFG_ANIM_FPS"
    elif [[ "$pick" == "$i_w" ]]; then
      local p; p="$(menu_pick "$(msg title_anim_width)" "400" "480" "640" "720" "960" "1280")" || continue
      GIF_MAX_WIDTH="$p"; printf '%s' "$GIF_MAX_WIDTH" >"$CFG_ANIM_W"
    elif [[ "$pick" == "$i_c" ]]; then
      local p; p="$(menu_pick "$(msg title_anim_colors)" "256" "192" "128" "64")" || continue
      GIF_COLORS="$p"; printf '%s' "$GIF_COLORS" >"$CFG_ANIM_COLORS"
    elif [[ "$pick" == "$i_mb" ]]; then
      # 12MB ≈ QQ 的动图上限
      local p; p="$(menu_pick "$(msg title_anim_budget)" "5" "8" "12" "20" "30" "$(msg anim_nolimit)")" || continue
      if [[ "$p" == "$(msg anim_nolimit)" ]]; then ANIM_TARGET_MB="0"; else ANIM_TARGET_MB="$p"; fi
      printf '%s' "$ANIM_TARGET_MB" >"$CFG_ANIM_MB"
    else
      return 0
    fi
  done
}

show_settings_menu() {
  while :; do
    local fps_display="${FRAMERATE:-$(msg fps_unlimited)}"
    local audio_display="${AUDIO}"
    local ad_display="${AUDIO_DEVICE:-$(msg audio_dev_default)}"
    if [[ "$ad_display" != "$(msg audio_dev_default)" ]] && ((${#ad_display} > 30)); then ad_display="${ad_display:0:12}...${ad_display: -12}"; fi
    local render_display_now="$(render_display "$DRM_DEVICE")"
    local ff_display; if [[ -z "$SAVE_EXT" || "${SAVE_EXT,,}" == "auto" ]]; then ff_display="$(msg ext_auto)"; else ff_display="$SAVE_EXT"; fi
    local current_codec; [[ "$ENGINE" == "wl-screenrec" ]] && current_codec="$CODEC_WL" || current_codec="$CODEC_WF"

    local pick; pick="$(menu_pick "$(msg title_settings)" "$(msg menu_set_engine "$ENGINE")" "$(msg menu_set_fps "$fps_display")" "$(msg menu_toggle_audio "$audio_display")" "$(msg menu_set_audio_dev "$ad_display")" "$(msg menu_set_codec "$current_codec")" "$(msg menu_set_filefmt "$ff_display")" "$(msg menu_set_render "$render_display_now")" "$(msg menu_anim_settings)" "$(msg menu_back)")" || return 0

    if [[ "$pick" == "$(msg menu_set_engine "$ENGINE")" ]]; then
      local new_eng="$(menu_pick "$(msg title_select_engine)" "wl-screenrec" "wf-recorder")" || continue
      ENGINE="$new_eng"; printf '%s' "$ENGINE" >"$CFG_ENGINE"
    elif [[ "$pick" == "$(msg menu_set_fps "$fps_display")" ]]; then
      local newf; newf="$(menu_pick "$(msg title_select_fps)" "60" "30" "120" "144" "165" "240" "$(msg fps_unlimited)")" || continue
      if [[ "$newf" == "$(msg fps_unlimited)" ]]; then FRAMERATE=""; rm -f "$CFG_FPS"
      elif [[ "$newf" =~ ^[0-9]+$ && "$newf" -gt 0 ]]; then FRAMERATE="$newf"; printf '%s' "$FRAMERATE" >"$CFG_FPS"; fi
    elif [[ "$pick" == "$(msg menu_toggle_audio "$audio_display")" ]]; then
      if [[ "$AUDIO" == "on" ]]; then AUDIO="off"; else AUDIO="on"; fi; printf '%s' "$AUDIO" >"$CFG_AUDIO"
    elif [[ "$pick" == "$(msg menu_set_audio_dev "$ad_display")" ]]; then choose_audio_device_menu
    elif [[ "$pick" == "$(msg menu_set_codec "$current_codec")" ]]; then
      if [[ "$ENGINE" == "wl-screenrec" ]]; then
        local newc="$(menu_pick "$(msg title_select_codec)" "auto" "avc" "hevc" "av1" "vp8" "vp9")" || continue
        CODEC_WL="$newc"; printf '%s' "$CODEC_WL" >"$CFG_CODEC_WL"
      else
        local newc="$(menu_pick "$(msg title_select_codec)" "libx264" "h264_vaapi" "hevc_vaapi" "av1_vaapi" "vp9_vaapi")" || continue
        CODEC_WF="$newc"; printf '%s' "$CODEC_WF" >"$CFG_CODEC_WF"
      fi
    elif [[ "$pick" == "$(msg menu_set_filefmt "$ff_display")" ]]; then choose_filefmt_menu
    elif [[ "$pick" == "$(msg menu_set_render "$render_display_now")" ]]; then choose_render_menu
    elif [[ "$pick" == "$(msg menu_anim_settings)" ]]; then choose_anim_menu
    elif [[ "$pick" == "$(msg menu_back)" ]]; then return 0
    fi
  done
}

decide_mode() {
  case "${RECORD_MODE,,}" in
    full|fullscreen) MODE_DECIDED="full";    return 0 ;;
    region|area)     MODE_DECIDED="region"; return 0 ;;
  esac
  local L_FULL L_REGION L_GIF L_OPEN_DIR L_SETTINGS L_EXIT

  while :; do
    L_FULL="$(msg menu_fullscreen)"
    L_REGION="$(msg menu_region)"
    L_GIF="$(msg menu_gif_region "$(anim_fmt_display)")"
    L_OPEN_DIR="$(msg menu_open_dir)"
    L_SETTINGS="$(msg menu_settings)"
    L_EXIT="$(msg menu_exit)"
    local pick; pick="$(menu_pick "$(msg title_mode)" "$L_FULL" "$L_REGION" "$L_GIF" "$L_OPEN_DIR" "$L_SETTINGS" "$L_EXIT")" || return 130
    if   [[ "$pick" == "$L_FULL"    ]]; then MODE_DECIDED="full";    return 0
    elif [[ "$pick" == "$L_REGION"  ]]; then MODE_DECIDED="region"; return 0
    elif [[ "$pick" == "$L_GIF"     ]]; then MODE_DECIDED="region"; IS_GIF_MODE="true"; return 0
    elif [[ "$pick" == "$L_OPEN_DIR" ]]; then open_save_dir; exit 0
    elif [[ "$pick" == "$L_SETTINGS" ]]; then show_settings_menu; continue
    elif [[ "$pick" == "$L_EXIT"    ]]; then return 130
    else return 130; fi
  done
}

geom_token() {
  local g="$1"
  awk 'NF==2{split($1,a,","); split($2,b,"x");
             if(a[1]!=""){printf "%sx%s@%s,%s",b[1],b[2],a[1],a[2]}}' <<<"$g"
}
pretty_dur() {
  local dur="${1:-0}"; [[ "$dur" =~ ^[0-9]+$ ]] || dur=0
  if ((dur>=3600)); then printf "%d:%02d:%02d" $((dur/3600)) $(((dur%3600)/60)) $((dur%60))
  else printf "%02d:%02d" $((dur/60)) $((dur%60)); fi
}
json_escape() { sed ':a;N;$!ba;s/\\/\\\\/g;s/"/\\"/g;s/\n/\\n/g'; }

# ================== 动图转换 (GIF / WebP) ==================
anim_fmt_display() { case "${ANIM_FORMAT,,}" in webp) printf "WebP" ;; *) printf "GIF" ;; esac; }
anim_ext()         { case "${ANIM_FORMAT,,}" in webp) printf "webp" ;; *) printf "gif"  ;; esac; }

human_size() {
  awk -v b="${1:-0}" 'BEGIN{
    if (b >= 1048576)   printf "%.1f MB", b/1048576;
    else if (b >= 1024) printf "%.0f KB", b/1024;
    else                printf "%d B", b }'
}
file_size() { stat -c%s "$1" 2>/dev/null || echo 0; }
probe_width() { ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$1" 2>/dev/null | head -1; }

# 降档阶梯：fps:宽度比例:色数，按预测体积单调递减，只在超出预算时才会用到。
#
# 第二项是"占输出宽度的比例"而不是绝对像素上限 —— 用绝对值的话，区域本来就比上限窄时
# （区域录制的常态）所有档位会被 clamp 成同一个宽度，等于只剩帧率和色数在动，粒度太粗，
# 会出现"预算 8MB 却直接掉到 12.5fps、成片只有 5.8MB"这种过度降档。
#
# 档位是按实测的体积模型 cost=(fps/25)*比例^2*(log2 色数/8) 解出来的，
# 罚分对每个维度取归一化降幅的平方（越深越贵），帧率权重最高。实测每省 1MB 的 SSIM 代价：
#   降分辨率 0.0002~0.0004 / 降色数 0.0007~0.0012 / 降帧率 0.0026~0.0030
# 所以前 9 档一直守住 25fps（体积已能压到 49%），实在不够才依次退到 20 / 16.7 / 12.5。
_ANIM_LADDER=(
  "25:1:256"     "25:1:192"     "25:1:160"     "25:0.95:160"
  "25:0.9:160"   "25:0.85:160"  "25:0.8:160"   "25:0.8:128"
  "25:0.75:128"  "20:0.75:128"  "16.6667:0.75:128"  "12.5:0.75:128"
)

# 抖动只在低色数时才划算。放大目视对比的结论：
#   256 / 192 / 160 / 128 色 —— 不抖动既更小（省约 10%）又更干净，渐变上看不到色带；
#   96 色以下              —— 不抖动会出现硬边阶梯，bayer 明显更接近原图。
# bayer 用固定图案，静止区域帧间完全一致，不会破坏 GIF 的透明差分（误差扩散类抖动会）。
_GIF_DITHER_BELOW=128   # 低于这个色数才开抖动
gif_dither_for() {
  local c="${1:-256}"
  if [[ "${GIF_DITHER_MODE,,}" != "auto" ]]; then printf '%s' "$GIF_DITHER_MODE"; return 0; fi
  if [[ "$c" =~ ^[0-9]+$ ]] && (( c >= _GIF_DITHER_BELOW )); then printf 'none'; else printf 'bayer:bayer_scale=5'; fi
}

# GIF 的帧延迟是整数厘秒，只有 100/n 这些帧率能被精确表示。
# 把任意帧率吸附到最近的可表示值，成片才不会像 30fps 那样被取整成 3cs、快放 11%。
gif_snap_fps() {
  awk -v f="${1:-20}" 'BEGIN{ d = int(100/f + 0.5); if (d < 1) d = 1; if (d > 100) d = 100; printf "%.10g", 100/d }'
}

# scale 里的 min(w,iw) 是关键：区域比上限窄时保持原生分辨率。
# 无条件写死 scale=720 会把小区域放大，像素数翻倍、插值噪点还会让 LZW 压不动，是体积失控的首因。
gif_filters() {
  printf "fps=%s,scale='min(%s,iw)':-1:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=%s:stats_mode=%s[p];[s1][p]paletteuse=dither=%s:diff_mode=rectangle" \
    "$(gif_snap_fps "$1")" "$2" "$3" "$GIF_STATS_MODE" "$(gif_dither_for "$3")"
}

encode_anim() { # src out fps maxw colors
  local src="$1" out="$2" fps="$3" maxw="$4" colors="$5"
  if [[ "${ANIM_FORMAT,,}" == "webp" ]]; then
    ffmpeg -y -v error -i "$src" -vf "fps=$fps,scale='min($maxw,iw)':-1:flags=lanczos" \
      -c:v libwebp_anim -lossless 0 -q:v "$WEBP_QUALITY" -compression_level 4 -loop 0 -an "$out"
  else
    ffmpeg -y -v error -i "$src" -vf "$(gif_filters "$fps" "$maxw" "$colors")" "$out"
  fi
}

# 可选：gifsicle 再压一遍。-O3 合并帧间差分区域，--lossy 允许轻微改写像素以拉长 LZW 游程。
gif_postprocess() {
  local f="$1" tmp
  [[ "${ANIM_FORMAT,,}" == "webp" ]] && return 0
  has gifsicle || return 0
  local -a gargs=( -O3 )
  if [[ "$GIF_LOSSY" =~ ^[1-9][0-9]*$ ]] && gifsicle --help 2>&1 | grep -q -- '--lossy'; then
    gargs+=( "--lossy=$GIF_LOSSY" )
  fi
  tmp="$f.opt"
  if gifsicle "${gargs[@]}" -o "$tmp" "$f" 2>/dev/null && [[ -s "$tmp" ]] \
     && (( $(file_size "$tmp") < $(file_size "$f") )); then
    mv -f "$tmp" "$f"
  else
    rm -f "$tmp"
  fi
  return 0
}

# 依据 [帧率 x 像素面积 x 调色板位宽] 预测各档体积，直接跳到够小的一档，避免逐档试压。
_anim_pick_rung() { # cur budget fps scale colors from use_colors dither_thr margin -> "idx|fps:scale:colors"
  printf '%s\n' "${_ANIM_LADDER[@]}" | awk \
    -v cur="$1" -v budget="$2" -v f0="$3" -v s0="$4" -v c0="$5" -v from="$6" -v usec="$7" -v dthr="$8" -v margin="$9" '
    BEGIN { best = -1; bestpred = cur * 0.9 }
    {
      idx = NR - 1; if (idx <= from) next
      split($0, k, ":"); f1 = k[1]; s1 = k[2]; c1 = k[3]
      cterm = usec ? (log(c1)/log(2)) / (log(c0)/log(2)) : 1
      # 开抖动约让体积涨 10%，跨阈值时必须算上，否则预测偏小、白压一遍
      dfac = 1
      if (usec && dthr > 0) dfac = ((c1 < dthr) ? 1.10 : 1.0) / ((c0 < dthr) ? 1.10 : 1.0)
      pred = cur * (f1/f0) * (s1/s0)^2 * cterm * dfac
      if (pred <= budget * margin) { print idx "|" $0; found = 1; exit }
      if (pred < bestpred) { bestpred = pred; best = idx; bestspec = $0 }
    }
    END { if (!found && best >= 0) print best "|" bestspec }'
}

# 把录好的中间视频转成动图。成功则把最终路径打到 stdout。
convert_to_anim() {
  local src="$1"
  local out_dir="$(get_save_dir)/$(anim_ext)"
  mkdir -p "$out_dir"
  local base="$(basename "$src")"
  local out="$out_dir/${base%.*}.$(anim_ext)"

  local iw="$(probe_width "$src")"; [[ "$iw" =~ ^[0-9]+$ ]] || iw=1920
  local budget=0
  [[ "$ANIM_TARGET_MB" =~ ^[1-9][0-9]*$ ]] && budget=$(( ANIM_TARGET_MB * 1048576 ))

  # 基准宽度 = 上限与源宽的较小值；阶梯里的比例都相对它，所以窄区域也能按比例降
  local base_w=$(( GIF_MAX_WIDTH < iw ? GIF_MAX_WIDTH : iw ))
  local use_colors=1; [[ "${ANIM_FORMAT,,}" == "webp" ]] && use_colors=0
  local fps="$GIF_FPS" scale=1 colors="$GIF_COLORS" maxw="$base_w"
  local tmp="$out_dir/.anim-$$.$(anim_ext)"   # ffmpeg 靠扩展名选封装器，临时文件也得带后缀
  local pass=0 rung=-1 size=0 produced=0 next spec

  while :; do
    pass=$(( pass + 1 ))
    if ! encode_anim "$src" "$tmp" "$fps" "$maxw" "$colors" || [[ ! -s "$tmp" ]]; then
      rm -f "$tmp"
      # 首次就失败才算真失败；重压失败则保留上一档已经压好的成品
      (( produced )) || return 1
      break
    fi
    gif_postprocess "$tmp"
    mv -f "$tmp" "$out"; produced=1
    size="$(file_size "$out")"
    if (( budget == 0 || size <= budget || pass >= 3 )); then break; fi
    local dthr=0; [[ "${GIF_DITHER_MODE,,}" == "auto" ]] && dthr="$_GIF_DITHER_BELOW"
    # 第一次重压不留余量，尽量把预算吃满、少掉画质；真超了第二次再保守，避免反复重压
    local margin=0.90; (( rung < 0 )) && margin=1.0
    next="$(_anim_pick_rung "$size" "$budget" "$fps" "$scale" "$colors" "$rung" "$use_colors" "$dthr" "$margin")"
    if [[ -z "$next" ]]; then break; fi
    rung="${next%%|*}"; spec="${next#*|}"
    fps="${spec%%:*}"; spec="${spec#*:}"; scale="${spec%%:*}"; colors="${spec##*:}"
    maxw="$(awk -v b="$base_w" -v s="$scale" 'BEGIN{ w = int(b*s + 0.5); if (w < 1) w = 1; print w }')"
    [[ "${DEBUG,,}" != "off" ]] && echo_terminal "超出预算($(human_size "$size"))，降档重压：${fps}fps / ${maxw}px / ${colors}色" >&2
  done

  printf '%s' "$out"
}

# ================== Start / Stop ==================
start_rec() {
  if [[ -f "$BOXPIDFILE" ]]; then
    local bpid; read -r bpid <"$BOXPIDFILE" 2>/dev/null || true
    [[ -n "$bpid" ]] && kill -9 "$bpid" 2>/dev/null || true
    rm -f "$BOXPIDFILE"
  fi

  if is_running; then 
    local msg="$(msg already_running)"
    echo_terminal "$msg"; notify "$msg"; exit 0
  fi
  
  has "$ENGINE" || { 
    local msg="$(msg err_engine_not_found "$ENGINE")"
    echo_terminal "$msg"; notify "$msg"; exit 1 
  }

  MODE_DECIDED=""
  if ! decide_mode; then echo_terminal "$(msg cancel_no_mode)"; emit_waybar_signal; exit 130; fi
  local mode="$MODE_DECIDED"

  if [[ "$IS_GIF_MODE" == "true" ]]; then
      has ffmpeg || { local msg="$(msg err_need_ffmpeg)"; echo_terminal "$msg"; notify "$msg"; emit_waybar_signal; exit 1; }
      SAVE_EXT="mp4"
      printf '%s' "$ANIM_FORMAT" >"$GIF_MARKER"
  else
      rm -f "$GIF_MARKER"
  fi

  local marker="" output="" GEOM="" gtok=""
  local -a args=()
  local ROOT_DIR="$(get_save_dir)"
  local TARGET_DIR
  if [[ "$mode" == "full" ]]; then TARGET_DIR="$ROOT_DIR/${SAVE_SUBDIR_FS}"; else TARGET_DIR="$ROOT_DIR"; fi
  mkdir -p "$TARGET_DIR"

  if [[ "$mode" == "full" ]]; then
    output="$(decide_output)"
    marker="FS${output:+-$output}"
  else
    if [[ -n "$REC_AREA" ]]; then GEOM="$REC_AREA"
    else
      has slurp || { local msg="$(msg err_need_slurp)"; echo_terminal "$msg"; notify "$msg"; emit_waybar_signal; exit 1; }
      set +e; GEOM="$(slurp)"; local rc=$?; set -e
      if [[ $rc -ne 0 || -z "${GEOM// /}" ]]; then echo_terminal "$(msg cancel_no_region)"; emit_waybar_signal; exit 130; fi
    fi
    local -a _g_arr=($GEOM)
    GEOM="${_g_arr[*]}"
    if [[ "${GEOM_IN_NAME,,}" == "on" ]]; then gtok="$(geom_token "$GEOM")"; marker="REGION${gtok:+-$gtok}"; else marker="REGION"; fi

    if [[ -n "$GEOM" && -f "$DRAWBOX" ]]; then
      if [[ "$GEOM" =~ ([0-9]+),([0-9]+)[[:space:]]+([0-9]+)x([0-9]+) ]]; then
        # 红框进程活到录制结束，别让它继承 stdout —— 否则 `脚本 | 任何命令` 会一直卡住等 EOF
        python3 "$DRAWBOX" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" >/dev/null 2>&1 &
        echo $! > "$BOXPIDFILE"
        sleep 0.3 
      fi
    fi
  fi

  local ts="$(date +'%Y-%m-%d-%H%M%S')"; local safe_title="${TITLE// /_}"
  local base="$ts${safe_title:+-$safe_title}-${marker}"
  local ext="$(choose_ext)"
  local SAVE_PATH="$TARGET_DIR/$base.$ext"
  local dev="$(pick_render_device)"

  case "$ENGINE" in
    wl-screenrec)
      [[ -n "$output" ]] && args+=( -o "$output" )
      [[ -n "$GEOM" ]]   && args+=( -g "$GEOM" )
      args+=( -f "$SAVE_PATH" )
      [[ -n "$dev" ]] && args+=( --dri-device "$dev" )
      [[ "$CODEC_WL" != "auto" ]] && args+=( --codec "$CODEC_WL" )
      if [[ "$AUDIO" == "on" ]]; then 
        args+=( --audio )
        local ad="$AUDIO_DEVICE"
        if [[ -z "$ad" ]] && has pactl; then
          local def_sink="$(pactl get-default-sink 2>/dev/null || true)"
          [[ -n "$def_sink" ]] && ad="${def_sink}.monitor"
        fi
        [[ -n "$ad" ]] && args+=( --audio-device "$ad" )
      fi
      if [[ -n "$FRAMERATE" ]]; then
        if [[ "$FRAMERATE" =~ ^[0-9]+$ && "$FRAMERATE" -gt 0 ]]; then args+=( -m "$FRAMERATE" )
        else echo_terminal "$(msg warn_invalid_fps "$FRAMERATE")" >&2; fi
      fi
      ;;
    wf-recorder)
      [[ -n "$output" ]] && args+=( -o "$output" )
      [[ -n "$GEOM" ]]   && args+=( -g "$GEOM" )
      args+=( --file "$SAVE_PATH" -c "$CODEC_WF" )
      [[ -n "$dev" ]] && args+=( -d "$dev" )
      if [[ "$AUDIO" == "on" ]]; then 
        local ad="$AUDIO_DEVICE"
        if [[ -z "$ad" ]] && has pactl; then
          local def_sink="$(pactl get-default-sink 2>/dev/null || true)"
          [[ -n "$def_sink" ]] && ad="${def_sink}.monitor"
        fi
        if [[ -n "$ad" ]]; then args+=( "--audio=$ad" )
        else args+=( "-a" ); fi
      fi
      if [[ -n "$FRAMERATE" ]]; then
        if [[ "$FRAMERATE" =~ ^[0-9]+$ && "$FRAMERATE" -gt 0 ]]; then args+=( --framerate "$FRAMERATE" )
        else echo_terminal "$(msg warn_invalid_fps "$FRAMERATE")" >&2; fi
      fi
      if [[ "$CODEC_WF" == *"_vaapi" ]]; then args+=( -F "scale_vaapi=format=nv12:out_range=full:out_color_primaries=bt709" )
      else args+=( -F "format=yuv420p" ); fi
      ;;
  esac

  setsid nohup "$ENGINE" "${args[@]}" >/dev/null 2>&1 &
  local pid=$!
  echo "$pid" >"$PIDFILE"
  date +%s >"$STARTFILE"
  echo "$SAVE_PATH" >"$SAVEPATH_FILE"
  echo "$mode" >"$MODEFILE"
  echo "$ENGINE" >"$CURRENT_ENGINE_FILE"

  local note; if [[ "$mode" == "full" ]]; then note="$(msg notif_started_full "${output:-Default}" "$SAVE_PATH")"; else note="$(msg notif_started_region "$SAVE_PATH")"; fi
  
  echo_terminal "\n=============================="
  echo_terminal "$note"
  echo_terminal "==============================\n"
  
  emit_waybar_signal
  start_tick
}

stop_rec() {
  if [[ -f "$BOXPIDFILE" ]]; then
    local bpid; read -r bpid <"$BOXPIDFILE" 2>/dev/null || true
    [[ -n "$bpid" ]] && kill -9 "$bpid" 2>/dev/null || true
    rm -f "$BOXPIDFILE"
  fi

  if ! is_running; then 
    rm -f "$PIDFILE" "$MODEFILE" "$CURRENT_ENGINE_FILE" "$TICKPIDFILE"
    local msg="$(msg not_running)"
    echo_terminal "$msg"; notify "$msg"; emit_waybar_signal; exit 0
  fi
  
  local pid; read -r pid <"$PIDFILE"
  local active_engine="$ENGINE"; [[ -r "$CURRENT_ENGINE_FILE" ]] && read -r active_engine <"$CURRENT_ENGINE_FILE"

  kill -INT "$pid" 2>/dev/null || true
  for _ in {1..40}; do sleep 0.1; is_running || break; done
  is_running && kill -TERM "$pid" 2>/dev/null || true
  sleep 0.2
  is_running && kill -KILL "$pid" 2>/dev/null || true

  rm -f "$PIDFILE" "$MODEFILE" "$CURRENT_ENGINE_FILE"
  stop_tick

  local save_path=""; [[ -r "$SAVEPATH_FILE" ]] && read -r save_path <"$SAVEPATH_FILE"
  
  if [[ -f "$GIF_MARKER" ]]; then
    # 取回开始录制时选定的格式（--webp / 菜单里的选择），再删 marker
    local marked=""; read -r marked <"$GIF_MARKER" 2>/dev/null || true
    case "${marked,,}" in gif|webp) ANIM_FORMAT="${marked,,}" ;; esac
    rm -f "$GIF_MARKER"
    if [[ -n "$save_path" && -f "$save_path" ]]; then
        local fmt_name="$(anim_fmt_display)"
        local msg="$(msg notif_processing_gif "$fmt_name")"
        echo_terminal "$msg"; notify "$msg"

        local anim_out=""
        if anim_out="$(convert_to_anim "$save_path")" && [[ -s "$anim_out" ]]; then
             [[ "${ANIM_KEEP_SOURCE,,}" == "on" ]] || rm -f "$save_path"
             save_path="$anim_out"
             echo "$save_path" > "$SAVEPATH_FILE"
             # 降到最低档仍超预算 => 内容运动量太大，GIF 本身就不适合，明说出来
             if [[ "$ANIM_TARGET_MB" =~ ^[1-9][0-9]*$ ]] \
                && (( $(file_size "$anim_out") > ANIM_TARGET_MB * 1048576 )); then
                local w="$(msg warn_anim_oversize "$(human_size "$(file_size "$anim_out")")" "$ANIM_TARGET_MB")"
                echo_terminal "$w"; notify "$w"
             fi
        else
             [[ -n "$anim_out" ]] && rm -f "$anim_out"
             local err_msg="$(msg notif_gif_failed "$fmt_name")"
             echo_terminal "$err_msg"; notify "$err_msg"
        fi
    fi
  fi

  if [[ -n "$save_path" && -f "$save_path" ]]; then
    ln -sf "$(basename "$save_path")" "$(dirname "$save_path")/latest" || true

    local cp_note=""
    if has wl-copy; then
        echo "file://${save_path}" | wl-copy --type text/uri-list
        cp_note="\n$(msg notif_copied)"
    fi

    local s="$(msg notif_saved "$save_path" "$(human_size "$(file_size "$save_path")")")${cp_note}"
    echo_terminal "\n=============================="
    echo_terminal "$s"
    echo_terminal "==============================\n"
    notify "$s"
  else
    local msg="$(msg notif_stopped)"
    echo_terminal "$msg"; notify "$msg"
  fi

  if [[ "${PKILL_AFTER_STOP,,}" != "off" ]]; then
    for sig in INT TERM KILL; do
      pgrep -x -u "$UID" "$active_engine" >/dev/null || break
      pkill -"$sig" -x -u "$UID" "$active_engine" 2>/dev/null || true
      sleep 0.1
    done
  fi
  emit_waybar_signal
}

# ================== Waybar JSON/status ==================
tooltip_idle_text() {
  case "$(lang_code)" in
    zh) cat <<EOF
屏幕录制 ($ENGINE)
左键：打开录制菜单
右键：强制关闭
EOF
      ;;
    *)  cat <<EOF
Screen recording ($ENGINE)
Left click: open recording menu
Right click: force stop
EOF
      ;;
  esac
}
tooltip_recording_text() {
  local t="$1" p="${2:-}" m="${3:-}"
  local mode_label
  case "$m" in full|fullscreen) mode_label="$(msg mode_full)";; region|area) mode_label="$(msg mode_region)";; *) mode_label="";; esac
  case "$(lang_code)" in
    zh) [[ -n "$p" ]] && { [[ -n "$mode_label" ]] && printf "录制中（%s - %s）\n已用时：%s\n文件：%s\n" "$mode_label" "$ENGINE" "$t" "$p" || printf "录制中 (%s)\n已用时：%s\n文件：%s\n" "$ENGINE" "$t" "$p"; } || { [[ -n "$mode_label" ]] && printf "录制中（%s - %s）\n已用时：%s\n" "$mode_label" "$ENGINE" "$t" || printf "录制中 (%s)\n已用时：%s\n" "$ENGINE" "$t"; } ;;
    *)  [[ -n "$p" ]] && { [[ -n "$mode_label" ]] && printf "Recording (%s - %s)\nElapsed: %s\nFile: %s\n" "$mode_label" "$ENGINE" "$t" "$p" || printf "Recording (%s)\nElapsed: %s\nFile: %s\n" "$ENGINE" "$t" "$p"; } || { [[ -n "$mode_label" ]] && printf "Recording (%s - %s)\nElapsed: %s\n" "$mode_label" "$ENGINE" "$t" || printf "Recording (%s)\nElapsed: %s\n" "$ENGINE" "$t"; } ;;
  esac
}
pretty_status_json() {
  local text tooltip class alt
  if is_running; then
    local start=0; [[ -r "$STARTFILE" ]] && read -r start <"$STARTFILE" || true
    [[ "$start" =~ ^[0-9]+$ ]] || start=0
    local now dur; now="$(date +%s)"; dur=$((now - start)); (( dur < 0 )) && dur=0
    local t="$(pretty_dur "$dur")"
    local save_path=""; [[ -r "$SAVEPATH_FILE" ]] && read -r save_path <"$SAVEPATH_FILE" || true
    local mode=""; [[ -r "$MODEFILE" ]] && read -r mode <"$MODEFILE" || true
    text="$ICON_REC$t"
    tooltip="$(tooltip_recording_text "$t" "$save_path" "$mode")"
    class="recording"; alt="rec"
  else
    text="$ICON_IDLE"; tooltip="$(tooltip_idle_text)"; class="idle"; alt="idle"
  fi
  printf '{"text":"%s","tooltip":"%s","class":"%s","alt":"%s"}\n' \
      "$(printf '%s' "$text"    | json_escape)" \
      "$(printf '%s' "$tooltip" | json_escape)" \
     "$class" "$alt"
}
status_rec() {
  local json="${1:-}"
  if [[ "$json" == "--json" ]]; then pretty_status_json
  else
    if is_running; then
      local start=0; [[ -r "$STARTFILE" ]] && read -r start <"$STARTFILE" || true
      [[ "$start" =~ ^[0-9]+$ ]] || start=0
      local now dur; now="$(date +%s)"; dur=$((now - start)); (( dur < 0 )) && dur=0
      printf "%s%s\n" "$ICON_REC" "$(pretty_dur "$dur")"
    else
      echo "$ICON_IDLE"
    fi
  fi
}

# ================== CLI Argument Parsing & Main ==================
COMMAND="toggle"
if [[ $# -gt 0 ]]; then
  case "$1" in
    start|stop|toggle|status|status-json|waybar|is-active|settings) COMMAND="$1"; shift ;;
    -h|--help|help) show_help; exit 0 ;;
    -*) COMMAND="toggle" ;;
    *) echo_terminal "未知命令: $1"; show_help; exit 1 ;;
  esac
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help|help) show_help; exit 0 ;;
    -f|--full|--fullscreen) RECORD_MODE="full" ;;
    -r|--region) RECORD_MODE="region" ;;
    -g|--gif)  RECORD_MODE="region"; IS_GIF_MODE="true"; ANIM_FORMAT="gif" ;;
    -w|--webp) RECORD_MODE="region"; IS_GIF_MODE="true"; ANIM_FORMAT="webp" ;;
    -a|--audio) AUDIO="on" ;;
    --no-audio) AUDIO="off" ;;
    -e|--engine) shift; [[ -n "${1:-}" ]] && ENGINE="$1" || { echo_terminal "错误: --engine 缺少参数"; exit 1; } ;;
    *) echo_terminal "未知参数: $1"; show_help; exit 1 ;;
  esac
  shift
done

case "$COMMAND" in
  start)          start_rec ;;
  stop)           stop_rec ;;
  status)         status_rec ;;
  status-json)    status_rec --json ;;
  waybar)         status_rec --json ;;
  is-active)      if is_running; then exit 0; else exit 1; fi ;;
  toggle)         is_running && stop_rec || start_rec ;;
  settings)       show_settings_menu ;;
esac
