# ================== 动图 (GIF / WebP) 参数 ==================
# 关于 GIF 体积，有两条硬性约束，配置时不要绕开：
#   1. GIF 没有帧间运动补偿，只有"和上一帧相同的像素填透明"这一种帧间优化。
#      画面一动，优化失效，体积随 [帧率 x 像素数 x 时长] 线性增长。
#      因此 GIF_MAX_WIDTH 是"上限"而非"目标"——低于它的区域必须保持原生分辨率，
#      放大只会凭空制造像素和插值噪点，把体积翻几倍。
#   2. GIF 的帧延迟以 1/100 秒为单位存储，只有 100/n 的帧率能被精确表示。
#      原先写死的 30fps 会被取整成 3cs，成片以 33.33fps 播放、比实际快 11%；
#      现在 gif_snap_fps() 会把任意帧率吸附到最近的可表示值，采样与播放始终一致。
#
# 默认取向是"在预算内把画质做到最好"：预算 12MB（QQ 上限）、25fps、256 色、不抖动。
# 压不进预算时按 _ANIM_LADDER 降档，顺序是先色数、再分辨率、帧率放到最后。
ANIM_FORMAT="${ANIM_FORMAT:-${anim_fmt_from_file:-gif}}"          # gif | webp
GIF_MAX_WIDTH="${GIF_MAX_WIDTH:-${anim_w_from_file:-720}}"        # 宽度上限：只缩小，绝不放大
GIF_FPS="${GIF_FPS:-${anim_fps_from_file:-25}}"                   # 任意值，转换时会吸附到 100/n
GIF_COLORS="${GIF_COLORS:-${anim_colors_from_file:-256}}"         # 调色板色数
GIF_DITHER_MODE="${GIF_DITHER_MODE:-auto}"                        # auto = 按色数自动选，见 gif_dither_for()
GIF_STATS_MODE="${GIF_STATS_MODE:-diff}"
ANIM_TARGET_MB="${ANIM_TARGET_MB:-${anim_mb_from_file:-12}}"      # 体积预算(MB)，超出自动降档重压；0=不限
GIF_LOSSY="${GIF_LOSSY:-0}"                                       # gifsicle --lossy 强度，0=关闭（画质优先默认不用）
WEBP_QUALITY="${WEBP_QUALITY:-80}"
ANIM_KEEP_SOURCE="${ANIM_KEEP_SOURCE:-off}"                       # on = 转换后保留中间的 mp4

# 配置文件可被手工编辑，非法值在这里兜住，不要带到 ffmpeg 命令行上
case "${ANIM_FORMAT,,}" in gif|webp) ANIM_FORMAT="${ANIM_FORMAT,,}" ;; *) ANIM_FORMAT="gif" ;; esac
[[ "$GIF_FPS" =~ ^[0-9]*[1-9][0-9]*(\.[0-9]+)?$|^[0-9]+\.[0-9]*[1-9][0-9]*$ ]] || GIF_FPS=20
[[ "$GIF_MAX_WIDTH"  =~ ^[1-9][0-9]*$        ]] || GIF_MAX_WIDTH=720
[[ "$GIF_COLORS"     =~ ^[0-9]+$ && $GIF_COLORS -ge 2 && $GIF_COLORS -le 256 ]] || GIF_COLORS=256
[[ "$ANIM_TARGET_MB" =~ ^[0-9]+$             ]] || ANIM_TARGET_MB=12
[[ "$WEBP_QUALITY"   =~ ^[0-9]+$ && $WEBP_QUALITY -le 100 ]] || WEBP_QUALITY=80

TITLE="${TITLE:-}"
SAVE_DIR_ENV="${SAVE_DIR:-}"
SAVE_SUBDIR_FS="${SAVE_SUBDIR_FS:-fullscreen}"
OUTPUT="${OUTPUT:-}"
OUTPUT_SELECT="${OUTPUT_SELECT:-auto}"
MENU_TITLE_OUTPUT="${MENU_TITLE_OUTPUT:-}"
MENU_BACKEND="${MENU_BACKEND:-auto}"
